{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -u -m http.server 4190 --bind 127.0.0.1",
      "startServerReadyPattern": "Serving HTTP",
      "url": [
        "http://127.0.0.1:4190/index.html",
        "http://127.0.0.1:4190/profil.html",
        "http://127.0.0.1:4190/parcours-recits.html",
        "http://127.0.0.1:4190/axes-recherche.html",
        "http://127.0.0.1:4190/interventions.html",
        "http://127.0.0.1:4190/mediatheque.html",
        "http://127.0.0.1:4190/contact.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": "off",
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 3000000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "rapports-lighthouse"
    }
  }
}
